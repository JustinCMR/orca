{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/stablyai/orca/main/schemas/plugins/orca-marketplace.v2.schema.json",
  "title": "Orca plugin catalog",
  "description": "The orca-marketplace.v2.json file that lists installable plugin releases.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema URL for editor completion. Ignored by Orca.",
      "x-orca-since": "1.4.233",
      "type": "string",
      "maxLength": 2048
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Marketplace display name.",
      "x-orca-since": "1.4.233",
      "examples": [
        "Orca Plugins"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "description": "Account that publishes the marketplace.",
      "x-orca-since": "1.4.233",
      "examples": [
        "stablyai"
      ]
    },
    "plugins": {
      "maxItems": 2048,
      "type": "array",
      "items": {
        "$ref": "#/$defs/CatalogEntry"
      },
      "description": "Listed plugins, at most 2048. Each `id` may appear once, or the whole catalog is refused. An entry this Orca cannot parse is skipped, not fatal.",
      "x-orca-since": "1.4.233"
    }
  },
  "required": [
    "name",
    "owner",
    "plugins"
  ],
  "$defs": {
    "CatalogEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "`<publisher>.<id>`, matching the plugin's manifest. Each half is at most 64 characters, and the reserved names `constructor` and `prototype` are refused.",
          "x-orca-since": "1.4.233",
          "examples": [
            "acme.gleam-syntax"
          ]
        },
        "source": {
          "$ref": "#/$defs/CatalogGitSource"
        },
        "description": {
          "description": "Listing text shown in the marketplace.",
          "x-orca-since": "1.4.233",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "categories": {
          "default": [],
          "description": "Lowercase slugs used to filter the marketplace, each listed once.",
          "x-orca-since": "1.4.233",
          "examples": [
            [
              "themes"
            ]
          ],
          "uniqueItems": true,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "release": {
          "$ref": "#/$defs/CatalogRelease"
        }
      },
      "required": [
        "id",
        "source",
        "release"
      ],
      "description": "One installable plugin."
    },
    "CatalogGitSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "git",
          "description": "Source kind. Only `git` is supported.",
          "x-orca-since": "1.4.233"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768,
          "description": "HTTPS or SSH URL of the plugin repository.",
          "x-orca-since": "1.4.233",
          "examples": [
            "https://github.com/acme/orca-gleam-syntax.git"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Branch or tag the author publishes from. A `release` pins the exact commit.",
          "x-orca-since": "1.4.233",
          "examples": [
            "main"
          ]
        }
      },
      "required": [
        "kind",
        "url",
        "ref"
      ],
      "description": "Where the plugin source lives."
    },
    "CatalogRelease": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The manifest's `version` for this release.",
          "x-orca-since": "1.4.233",
          "examples": [
            "1.2.0"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full SHA-1 commit Orca checks out for this release.",
          "x-orca-since": "1.4.233"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the plugin's installed files, as Orca computes it at install.",
          "x-orca-since": "1.4.233"
        },
        "execution": {
          "type": "string",
          "enum": [
            "data",
            "instructional",
            "sandboxed-ui",
            "trusted-worker"
          ],
          "description": "The manifest's `execution` profile.",
          "x-orca-since": "1.4.233",
          "examples": [
            "data"
          ]
        },
        "minimumOrca": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "The manifest's `engines.orca` without `>=`. Older Orca lists the plugin but will not install it.",
          "x-orca-since": "1.4.233",
          "examples": [
            "1.4.233"
          ]
        },
        "types": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "interface-language",
              "app-theme",
              "terminal-theme",
              "icon-theme",
              "syntax",
              "instructions",
              "panel",
              "worker"
            ]
          },
          "description": "Every kind of contribution the release carries, matching its manifest exactly. `instructions` needs the `instructional` profile or higher, `panel` needs `sandboxed-ui`, and `worker` needs `trusted-worker`.",
          "x-orca-since": "1.4.233",
          "examples": [
            [
              "syntax"
            ]
          ],
          "uniqueItems": true
        },
        "name": {
          "description": "The manifest's `name`, so Orca can suggest the plugin before downloading it.",
          "x-orca-since": "1.4.233",
          "examples": [
            "Gleam"
          ],
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "license": {
          "description": "SPDX license expression.",
          "x-orca-since": "1.4.233",
          "examples": [
            "MIT"
          ],
          "type": "string",
          "maxLength": 128,
          "pattern": "^\\(?[A-Za-z0-9][A-Za-z0-9.+-]*(?: (?:AND|OR|WITH) \\(?[A-Za-z0-9][A-Za-z0-9.+-]*\\)?)*\\)?$"
        },
        "repository": {
          "description": "Source repository page, https only.",
          "x-orca-since": "1.4.233",
          "examples": [
            "https://github.com/acme/orca-gleam-syntax"
          ],
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https:\\/\\/\\S+$"
        },
        "homepage": {
          "description": "Project homepage, https only.",
          "x-orca-since": "1.4.233",
          "examples": [
            "https://example.com/gleam"
          ],
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https:\\/\\/\\S+$"
        },
        "updatedAt": {
          "description": "When this release was published, as an ISO 8601 date or date-time.",
          "x-orca-since": "1.4.233",
          "examples": [
            "2026-10-20"
          ],
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          ]
        },
        "changelog": {
          "description": "What changed in this release, as plain text. At most 2000 characters.",
          "x-orca-since": "1.4.233",
          "examples": [
            "Adds highlighting for use expressions."
          ],
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "fileTypes": {
          "description": "Extensions, without the dot, that this release opens. Orca suggests the plugin when such a file has no viewer.",
          "x-orca-since": "1.4.233",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+_-]{0,15}$"
          }
        }
      },
      "required": [
        "version",
        "commit",
        "contentHash",
        "execution",
        "minimumOrca",
        "types"
      ],
      "description": "The exact release the catalog vouches for. Orca refuses bytes that differ."
    }
  }
}
